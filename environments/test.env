# TEST : poste du développeur / CI. Ce sont aussi les valeurs par défaut du docker-compose.yml.
# Usage : docker compose --env-file .env --env-file environments/test.env up --build
APP_ENV=test
IMAGE_TAG=dev
HTTP_PORT=8080
RESTART_POLICY=no

# Swagger activé
NODE_ENV=test
DOCS_ENABLED=true
JWT_EXPIRES_IN=1h

# Limites CPU / mémoire
PROXY_CPUS=0.5
PROXY_MEMORY=128M
RABBITMQ_CPUS=0.5
RABBITMQ_MEMORY=512M
DB_CPUS=1
DB_MEMORY=768M
AUTH_CPUS=1
AUTH_MEMORY=768M
NODE_CPUS=0.5
NODE_MEMORY=256M
