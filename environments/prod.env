# PROD : images versionnées publiées par la CI, aucune reconstruction.
# Usage : docker compose --env-file .env --env-file environments/prod.env pull
#         docker compose --env-file .env --env-file environments/prod.env up -d --no-build
APP_ENV=prod
# Tag publié par docker-release.yml (majeur "1", mineur "1.0" ou exact "1.0.0")
IMAGE_TAG=1
HTTP_PORT=80
RESTART_POLICY=always

# Swagger désactivé
NODE_ENV=production
DOCS_ENABLED=false
JWT_EXPIRES_IN=1h

# Limites CPU / mémoire
PROXY_CPUS=1
PROXY_MEMORY=256M
RABBITMQ_CPUS=1
RABBITMQ_MEMORY=1G
DB_CPUS=2
DB_MEMORY=2G
AUTH_CPUS=2
AUTH_MEMORY=1G
NODE_CPUS=1
NODE_MEMORY=512M
