# UAT : recette, au plus près de la production avec les images publiées.
# Usage : docker compose --env-file .env --env-file environments/uat.env pull
#         docker compose --env-file .env --env-file environments/uat.env up -d --no-build
APP_ENV=uat
IMAGE_TAG=dev
HTTP_PORT=8081
RESTART_POLICY=unless-stopped

# Comportement de production, Swagger gardé côté auth pour la recette
NODE_ENV=production
DOCS_ENABLED=true
JWT_EXPIRES_IN=1h

# Limites CPU / mémoire
PROXY_CPUS=0.5
PROXY_MEMORY=128M
RABBITMQ_CPUS=0.5
RABBITMQ_MEMORY=512M
DB_CPUS=1
DB_MEMORY=1G
AUTH_CPUS=1
AUTH_MEMORY=768M
NODE_CPUS=0.5
NODE_MEMORY=384M
